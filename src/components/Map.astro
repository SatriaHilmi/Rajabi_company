---

---

<div class="pt-20">
    <!-- Title -->
    <div class="mx-auto w-full max-w-2xl px-5 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-green-700">
            LOKASI KAMI
        </h1>
        <p class="mt-3 text-sm md:text-base text-gray-600 leading-relaxed">
            Temukan lokasi kami dengan mudah melalui peta di bawah ini. Anda
            bisa langsung membuka Google Maps untuk mendapatkan rute tercepat
            menuju tempat kami.
        </p>
    </div>

    <!-- Card -->
    <section class="max-w-xl md:max-w-6xl mx-auto px-5 py-10">
        <div
            class="rounded-3xl bg-white shadow-xl border border-green-500 overflow-hidden"
        >
            <!-- Header Card -->
            <div
                class="p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
            >
                <div>
                    <h2 class="text-xl md:text-2xl font-bold text-green-700">
                        UD. SUMBER REJEKI
                    </h2>
                    <p class="text-sm md:text-base text-gray-600 mt-2 max-w-xl">
                        Kami siap melayani pembelian dan konsultasi seputar
                        produk. Silakan datang langsung atau cek lokasi terlebih
                        dahulu melalui peta.
                    </p>
                </div>

                <!-- Button -->
                <a
                    href="https://maps.app.goo.gl/JiyJZWT2h6trcSqS8"
                    target="_blank"
                    class="inline-flex items-center justify-center rounded-full bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-green-700 transition"
                >
                    Buka di Google Maps →
                </a>
            </div>

            <!-- Map -->
            <div class="p-4 md:p-6">
                <div class="rounded-2xl overflow-hidden border border-gray-200">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3323.8461421171437!2d113.2007657454394!3d-7.817165648524077!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zN8KwNDknMDIuMSJTIDExM8KwMTInMDEuMyJF!5e0!3m2!1sen!2sid!4v1769383543059!5m2!1sen!2sid"
                        style="border:0;"
                        allowfullscreen
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="w-full h-80 md:h-105"></iframe>
                </div>

                <!-- Footer Info -->
                <div
                    class="mt-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3"
                >
                    <p class="text-sm text-gray-600">
                        📍 Probolinggo, Jawa Timur — buka senin - jumat
                    </p>
                    <p class="text-sm text-gray-500">
                        Klik peta untuk memperbesar & melihat detail lokasi
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>

