                            </span>

                            Tentang perusahaan

                            <span
                                class="ml-auto text-gray-400 transition group-open:rotate-180"
                            >
                                ▼
                            </span>
                        </summary>

                        <div
                            class="mt-3 text-gray-600 leading-relaxed overflow-hidden dropdown-content overflow-y-auto pr-2"
                        >
                            {company.description}
                        </div>
                    </details>

                    <div class="mt-8 flex flex-col sm:flex-row gap-3">
                        <a
                            href={company.whatsapp}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex justify-center items-center rounded-full bg-green-600 px-6 py-3 text-white font-semibold shadow-lg hover:bg-green-700 transition"
