---
const company = {
    name: "UD. SUMBER REJEKI",
    tagline: "Perusahaan produsen kayu terbaik dan terpercaya di Probolinggo.",
    description:
        "UD. SUMBER REJEKI merupakan badan usaha yang bergerak di berbagai bidang usaha strategis, meliputi pengolahan kayu, general trading, pengolahan limbah non B3, serta penyewaan alat berat konstruksi. Perusahaan ini didirikan dengan komitmen untuk memberikan produk dan layanan yang berkualitas, efisien, dan berorientasi pada kepuasan pelanggan. Dalam bidang pengolahan kayu, UD. SUMBER REJEKI menyediakan berbagai produk olahan kayu yang diproses secara profesional dengan memperhatikan standar mutu dan keberlanjutan. Pada sektor general trading, perusahaan melayani perdagangan berbagai jenis barang dan kebutuhan industri maupun umum dengan sistem distribusi yang andal. Selain itu, UD. SUMBER REJEKI juga bergerak di bidang pengolahan limbah non B3, sebagai bentuk kontribusi perusahaan terhadap pengelolaan lingkungan yang bertanggung jawab dan ramah lingkungan. Di sektor penyewaan alat berat konstruksi, perusahaan menyediakan berbagai jenis alat berat yang siap digunakan untuk mendukung proyek konstruksi, infrastruktur, dan pekerjaan teknik lainnya. Dengan didukung oleh sumber daya manusia yang berpengalaman dan manajemen yang profesional, UD. SUMBER REJEKI berkomitmen untuk menjadi mitra usaha yang terpercaya, berdaya saing, serta mampu memberikan nilai tambah bagi seluruh pemangku kepentingan.",
    whatsapp:
        "https://wa.me/6282258247255?text=Halo%20Admin%2C%20saya%20ingin%20bertanya%20tentang%20produk%20UD.%20Sumber%20Rejeki.",
};
import Layout from "../layouts/Layout.astro";
---

<Layout title="About - UD. Sumber Rejeki">
    <section class="relative overflow-hidden">
        <!-- Background -->
        <div
            class="absolute inset-0 bg-linear-to-br from-green-50 via-white to-green-100"
        >
        </div>
        <div
            class="absolute -top-20 -right-20 h-72 w-72 rounded-full bg-green-300/30 blur-3xl"
        >
        </div>
        <div
            class="absolute -bottom-20 -left-20 h-72 w-72 rounded-full bg-green-400/20 blur-3xl"
        >
        </div>

        <!-- Content -->
        <div class="relative max-w-6xl mx-auto px-5 py-20">
            <!-- Hero -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <p
                        class="inline-flex items-center gap-2 text-sm font-semibold text-green-700 bg-green-100 px-4 py-2 rounded-full"
                    >
                        Tentang Kami
                    </p>

                    <h1
                        class="mt-5 text-4xl md:text-5xl font-extrabold text-green-700 leading-tight"
                    >
                        {company.name}
                    </h1>

                    <p
                        class="mt-4 text-lg md:text-xl text-gray-600 leading-relaxed"
                    >
                        {company.tagline}
                    </p>

                    <details
                        class="mt-6 group rounded-2xl border border-green-500 bg-white/60 backdrop-blur px-5 py-4 shadow-sm"
                    >
                        <summary
                            class="cursor-pointer select-none font-semibold text-gray-800 flex items-center gap-3"
                        >
