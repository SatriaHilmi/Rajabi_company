---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { Bgslider } from "../components/Bgslider";
import { Produk } from "../components/Produk";
import Map from "../components/Map.astro";
---

<Layout title="Home - UD. Sumber Rejeki">
	<section class="relative overflow-hidden">
		<div
			class="absolute inset-0 bg-linear-to-br from-green-50 via-white to-green-100"
		>
		</div>
		<div
			class="absolute -top-24 -right-24 h-80 w-80 rounded-full bg-green-300/30 blur-3xl"
		>
		</div>
		<div
			class="absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-green-400/20 blur-3xl"
		>
		</div>

		<!-- HERO -->
		<section class="relative py-30 overflow-hidden">
			<Bgslider client:load />

			<!-- overlay hero -->
			<div class="absolute inset-0 bg-black/60"></div>

			<div class="relative z-10 px-4 md:px-5 top-15">
				<div class="max-w-xl md:max-w-2xl">
					<h1
						class="text-4xl md:text-7xl font-extrabold leading-[1.05] mb-4"
					>
						<span class="block text-white">Perusahaan Kayu</span>
						<span class="block text-green-500">Terbaik</span>
						<span class="block text-white">di Indonesia</span>
					</h1>

					<div
						class="border-l-4 border-green-500 pl-4 md:pl-6 rounded-md"
					>
						<p
							class="text-sm md:text-lg font-medium text-gray-300 leading-relaxed mb-5"
						>
							Menyediakan berbagai macam produk kayu berkualitas
							tinggi, hadir di berbagai kota yang berpusat di Kota
							Probolinggo Jawa Timur.
						</p>

						<h2
							class="text-white text-xl md:text-2xl font-semibold tracking-wide"
						>
							UD. SUMBER REJEKI
						</h2>
					</div>
				</div>
			</div>

			<!-- gradient ke atas (bagian bawah hero) -->
			<div
				class="absolute bottom-0 left-0 right-0 h-20 bg-linear-to-t from-green-50 via-white/60 to-transparent z-10"
			>
			</div>
		</section>

		<!-- Content utama -->
		<div class="relative z-10">
			<Card />

			<!-- About ringkas -->
			<div class="mx-auto max-w-xl md:max-w-3xl my-20 px-4">
				<h2
					class="text-3xl md:text-4xl font-bold mb-5 text-center text-green-700"
				>
					UD. SUMBER REJEKI
				</h2>

				<div
					class="border-l-4 border-green-500 pl-4 md:pl-5 rounded-md"
				>
					<p
						class="text-lg md:text-xl text-gray-700 mb-5 leading-relaxed"
					>
						UD. Sumber Rejeki adalah perusahaan perdagangan kayu
						yang berbasis di Kota Probolinggo Jawa Timur, Indonesia.
						Berbekal pengalaman bertahun-tahun dalam industri
						perkayuan, kami telah memantapkan posisi sebagai
						penyedia utama kayu keras berkualitas tinggi, dengan
						spesialisasi khusus pada Kayu Sonokeling (East Indian
						Rosewood). Kami memahami bahwa kayu bukan sekadar
						material bangunan, melainkan investasi nilai estetika
						dan ketahanan. Oleh karena itu, UD. Sumber Rejeki
						berkomitmen untuk menyediakan material kayu yang telah
						melalui proses seleksi ketat demi memenuhi standar
						kebutuhan industri furnitur mewah, instrumen musik,
						hingga kebutuhan ekspor.
					</p>
				</div>

				<a
					href="/About"
					class="text-green-600 hover:underline font-semibold"
					id="produk"
				>
					Learn More About Us →
				</a>
			</div>

			<!-- Produk -->
			<div class="mx-auto max-w-xl md:max-w-3xl px-4 my-20">
				<h1
					class="text-3xl md:text-4xl font-bold mb-5 text-center text-green-700"
				>
					PRODUK KAMI
				</h1>

				<div
					class="border-l-4 border-green-500 pl-4 md:pl-5 rounded-md"
				>
					<p
						class="text-lg md:text-xl text-gray-700 mb-5 leading-relaxed"
					>
						Kami dikenal sebagai spesialis kayu Sonokeling yang
						memiliki corak warna ungu kecokelatan yang eksotis
						dengan serat kayu yang sangat kuat. Produk Sonokeling
						kami tersedia dalam bentuk Log (Kayu Gelondongan), dan
						Papan (Sawn Timber).
					</p>
				</div>
			</div>

			<Produk />

			<Map />
		</div>
	</section>
</Layout>
